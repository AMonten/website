# El HTML y el CSS se revalidan siempre (este sitio no usa nombres de
# archivo con hash, así que cachear agresivamente el CSS deja a los
# visitantes viendo una versión vieja durante hasta un año cada vez que
# se edita styles.css/white-blue.css/reset.css sin cambiar de nombre).
# Los íconos/imágenes sí se cachean agresivamente porque rara vez cambian.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*.css
  Cache-Control: public, max-age=0, must-revalidate

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=31536000, immutable

/site.webmanifest
  Cache-Control: public, max-age=86400
